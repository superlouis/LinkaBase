LINKABASE_HOST=127.0.0.1
LINKABASE_PORT=8501
LINKABASE_EDITOR_PORT=8090
EDITOR_PUBLIC_URL=http://localhost:8090
# Docker listen address (used by Compose):
BIND_ADDRESS=127.0.0.1
# Optional data location for uv (Docker mounts ./workspace separately):
# WORKSPACE_DIR=/absolute/path/to/workspace
# Optional editor override. Not needed; compiled assets are bundled:
# EDITOR_DIST_DIR=/absolute/path/to/editor_dist

# Docker host folder or mounted local/block volume:
# LINKABASE_DATA_DIR=/mnt/linkabase-data
